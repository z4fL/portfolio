# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local
tmp

# Ignore assets in old version and exclude asset css js
public/old/1/assets/*
!public/old/1/assets/*.js
!public/old/1/assets/*.css

# Ignore PNG and JPG/JPEG files
*.png
*.PNG
*.jpg
*.JPG
*.jpeg
*.JPEG

# Explicitly allow WebP files (override if needed, though not strictly required since they aren't matched above)
!*.webp
!*.WEBP


# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

.claude
.codex
